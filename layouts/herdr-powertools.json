{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "usage-side",
          "type": "block",
          "size": {
            "px": 62
          },
          "content": {
            "mod": "agent-usage",
            "props": {
              "role": "side"
            }
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-sidebar"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "mark-agents-unread"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-names"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-names",
                      "props": { "terminalHistory": true }
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "veil": 0.3,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "file-explorer"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "git-panel"
                      }
                    },
                    {
                      "id": "search",
                      "type": "block",
                      "content": {
                        "mod": "project-search",
                        "props": {
                          "back": {
                            "stack": "panel-body",
                            "child": "files"
                          }
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "resizable": false,
          "size": {
            "px": 28
          },
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "hide-names"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "spotify-status",
              "type": "block",
              "content": {
                "mod": "spotify-mini",
                "props": { "statusBlock": "spotify-status" }
              },
              "size": { "px": 32 }
            },
            {
              "id": "back-forward",
              "type": "block",
              "content": {
                "mod": "back-and-forward"
              },
              "size": {
                "px": 76
              }
            },
            {
              "id": "quick-actions-status",
              "type": "block",
              "content": {
                "mod": "quick-actions",
                "props": {
                  "part": "status"
                }
              },
              "size": {
                "px": 34
              }
            }
          ]
        },
        {
          "id": "search-keys",
          "type": "block",
          "content": {
            "mod": "project-search",
            "props": {
              "keys": true,
              "show": {
                "stack": "panel-body",
                "child": "search",
                "panel": "panel"
              }
            }
          },
          "size": {
            "px": 0
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border",
    "hover": "accent"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "link_handlers": [
    "editor-links"
  ],
  "toast": "toast-names"
}
